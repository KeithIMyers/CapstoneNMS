APP_NAME="CapstoneNMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use `debug` only in local/dev — debug logs can include emails and other PII.
# Production should be `warning` or higher.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=example_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Force the session cookie to HTTPS-only. Override to false ONLY for local
# development over plain HTTP — never on production.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe (laravel/cashier). The webhook secret MUST be set when subscriptions
# are enabled — Cashier verifies the signature on incoming webhook events
# only when this is present. Without it, the /stripe/webhook endpoint will
# accept forged billing events.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Ask-the-newsroom paywall. The Site Settings → "Ask paywall" tab
# overrides each value at runtime via getcong(). These are the
# initial defaults applied on a fresh install.
#  -1 = unlimited; 0 = blocked entirely.
PAYWALL_ASK_ENABLED=false
PAYWALL_ASK_ANON_MONTHLY=3
PAYWALL_ASK_USER_MONTHLY=10
PAYWALL_ASK_SUB_MONTHLY=100

# Article gifts (subscriber-shared single-use links)
PAYWALL_GIFTS_ENABLED=true
PAYWALL_GIFTS_MONTHLY_CAP=5
PAYWALL_GIFTS_TTL_DAYS=14

# Mail-provider webhook receivers for newsletter analytics. Configure
# *one* of these (matching your MAIL_MAILER) so deliveries / opens /
# clicks / bounces / complaints flow back into the Newsletter Issues
# dashboard.
#   POSTMARK_WEBHOOK_USER / POSTMARK_WEBHOOK_PASSWORD: Basic-Auth pair
#     pasted into Postmark's Webhook URL as https://user:pass@host/...
#   MAILGUN_WEBHOOK_SIGNING_KEY: from Sending → Webhooks (NOT the API key)
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=
MAILGUN_WEBHOOK_SIGNING_KEY=

# Comma-separated list of upstream proxy IPs / CIDRs whose X-Forwarded-*
# headers we trust. Any client outside this list has its forwarded
# headers ignored, so direct attackers can't forge X-Forwarded-For to
# bypass rate limits or X-Forwarded-Proto to weaken cookies. Set to "*"
# only when you fully control the network path. Default: 127.0.0.1
# (Apache → PHP-FPM on the same host). For Cloudflare add their
# published IPv4 + IPv6 ranges.
TRUSTED_PROXIES=127.0.0.1
