#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use CapstoneNMS\Keygen\Commands\BootstrapCommand;
use CapstoneNMS\Keygen\Commands\MintCommand;
use CapstoneNMS\Keygen\Commands\VerifyCommand;
use Symfony\Component\Console\Application;

$app = new Application('CapstoneNMS keygen', '1.0.0');
$app->addCommands([
    new BootstrapCommand(),
    new MintCommand(),
    new VerifyCommand(),
]);
$app->run();
